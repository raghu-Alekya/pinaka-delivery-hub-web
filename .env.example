# Browser-safe API base URL (must start with VITE_ to be available in React).
# No trailing slash. Example: http://192.168.1.10:3000/api
VITE_API_URL=http://localhost:3000/api

# Optional path overrides (appended to VITE_API_URL)
VITE_LOGIN_PATH=/auth/login
VITE_REGISTER_PATH=/auth/register

# PostgreSQL host/user/password belong on the backend server only.
# Do not add DB_* or DATABASE_URL here with a VITE_ prefix.
